---------------------------
# ไฟล์ตัวอย่างสำหรับเครื่องพัฒนาเท่านั้น ให้คัดลอกเป็น .env.local แล้วใส่ค่าลับในเครื่องของผู้ใช้
# ห้ามตั้งชื่อตัวแปรฐานข้อมูลขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามนำค่าลับไปใส่ใน next.config.ts


# ===== การเชื่อมต่อฐานข้อมูลหลักแบบอ่านอย่างเดียว =====
# เปิดหรือปิดการเชื่อมต่อฐานข้อมูลหลัก: true = เปิด, false = ปิด
FACTORY_DB_ENABLED=false
# ที่อยู่ Cloud SQL Proxy ซึ่งทำงานอยู่ในเครื่องนี้
FACTORY_DB_HOST=127.0.0.1
# พอร์ตที่ Cloud SQL Proxy เปิดรับการเชื่อมต่อ
FACTORY_DB_PORT=5433
# ชื่อฐานข้อมูล PostgreSQL ที่โปรเจกต์จะเชื่อมต่อ
FACTORY_DB_NAME=production
# ชื่อ schema ของโรงงาน Foliar Fertilizer ภายในฐานข้อมูล production
FACTORY_DB_SCHEMA=foliar_fertilizer
# บัญชี runtime ของแอป ใช้ตรวจการเชื่อมต่อและอ่านข้อมูลตามสิทธิ์ที่ได้รับ
FACTORY_DB_USER=foliar_fertilizer_app
# รหัสผ่านของ foliar_fertilizer_app ต้องใส่เฉพาะใน .env.local และห้าม commit
FACTORY_DB_PASSWORD=
# จำนวน connection สูงสุดที่เก็บใน pool เพื่อไม่ให้แอปใช้ connection มากเกินไป
FACTORY_DB_POOL_MAX=5
# เวลาสูงสุดที่รอเชื่อมต่อฐานข้อมูล หน่วยเป็นมิลลิวินาที
FACTORY_DB_CONNECT_TIMEOUT_MS=5000
# เวลาที่ connection ว่างได้ก่อนถูกปิด หน่วยเป็นมิลลิวินาที
FACTORY_DB_IDLE_TIMEOUT_MS=10000
# เวลาสูงสุดที่อนุญาตให้คำสั่ง SQL ทำงาน หน่วยเป็นมิลลิวินาที
FACTORY_DB_STATEMENT_TIMEOUT_MS=5000


# ===== โมดูลตั้งค่าระบบ =====
# เปิดการบันทึกข้อมูลของโมดูลตั้งค่า เปิดได้หลังสร้างตารางและสิทธิ์ของโมดูลนี้แล้วเท่านั้น
FACTORY_SETTINGS_ENABLED=false
# บัญชีเขียนข้อมูลของโมดูลตั้งค่า ห้ามใช้บัญชีเดียวกับฐานข้อมูลแบบอ่านอย่างเดียว
FACTORY_SETTINGS_DB_USER=factory_settings_writer
# รหัสผ่านของบัญชีเขียนข้อมูลโมดูลตั้งค่า ใส่เฉพาะใน .env.local
FACTORY_SETTINGS_DB_PASSWORD=
# URL ของเว็บที่อนุญาตให้เรียก API โมดูลตั้งค่าระหว่างพัฒนา
FACTORY_SETTINGS_APP_ORIGIN=http://localhost:3002


# ===== โมดูลใบสั่งผลิต =====
# เปิดการบันทึกใบสั่งผลิต เปิดได้หลังสร้างตารางและสิทธิ์ของโมดูลนี้แล้วเท่านั้น
FACTORY_PRODUCTION_ENABLED=false
# บัญชีเขียนข้อมูลใบสั่งผลิต ห้ามใช้ร่วมกับบัญชีโมดูลตั้งค่าหรือบัญชีอ่านอย่างเดียว
FACTORY_PRODUCTION_DB_USER=factory_production_writer
# รหัสผ่านของบัญชีเขียนข้อมูลใบสั่งผลิต ใส่เฉพาะใน .env.local
FACTORY_PRODUCTION_DB_PASSWORD=
# URL ของเว็บที่อนุญาตให้เรียก API ใบสั่งผลิตระหว่างพัฒนา
FACTORY_PRODUCTION_APP_ORIGIN=http://localhost:3000


# ===== โมดูลจัดซื้อ PR และ PO =====
# เปิดการบันทึก PR/PO เปิดได้หลังอนุมัติ migration 0006 และสร้างบัญชีสิทธิ์ขั้นต่ำแล้ว
FACTORY_PURCHASING_ENABLED=false
# บัญชีเขียนข้อมูลของโมดูลจัดซื้อ
FACTORY_PURCHASING_DB_USER=factory_purchasing_writer
# รหัสผ่านของบัญชีเขียนข้อมูลโมดูลจัดซื้อ ใส่เฉพาะใน .env.local
FACTORY_PURCHASING_DB_PASSWORD=


# ===== ระบบยืนยันตัวตนด้วย PostgreSQL =====
# เปิดระบบ login ที่เก็บข้อมูลใน PostgreSQL เปิดได้หลังอนุมัติ migration และกำหนดขอบเขตโรงงานแล้ว
FACTORY_AUTH_ENABLED=false
# บัญชีฐานข้อมูลที่ระบบยืนยันตัวตนใช้ระหว่างทำงาน
FACTORY_AUTH_DB_USER=factory_auth_runtime
# รหัสผ่านของบัญชีฐานข้อมูลระบบยืนยันตัวตน ใส่เฉพาะใน .env.local
FACTORY_AUTH_DB_PASSWORD=
# URL ของเว็บที่อนุญาตให้เรียก API ระบบยืนยันตัวตน
FACTORY_AUTH_APP_ORIGIN=http://localhost:3000
# เปิดการผูกผู้ใช้กับ tenant, organization และ site ในเครื่องพัฒนา
FACTORY_AUTH_LOCAL_SCOPE_ENABLED=false
# รายการ tenant, organization และ site ที่ผ่านการอนุมัติ ใช้เมื่อเปิดค่าด้านบนเท่านั้น
# FACTORY_AUTH_LOCAL_SCOPE_REGISTRY={"provenance":"<approved protected config>","settingsSiteAuthority":"<approved namespace>","tenant":{"authority":"<approved namespace>","id":"<approved id>","active":true},"organization":{"authority":"<approved namespace>","id":"<approved id>","tenantAuthority":"<same approved tenant namespace>","tenantId":"<same approved tenant id>","active":true},"sites":[{"authority":"<same Settings namespace>","id":"<verified active Settings site id>","organizationAuthority":"<same approved organization namespace>","organizationId":"<same approved organization id>","active":true}]}


# ===== ระบบ login ชั่วคราวสำหรับพัฒนา UI =====
# เปิด login แบบ local โดยไม่ใช้ PostgreSQL ใช้ได้เฉพาะ development และ localhost
FACTORY_DEV_AUTH_ENABLED=false
# อีเมลสำหรับ login เข้า UI ในเครื่องพัฒนา
FACTORY_DEV_AUTH_EMAIL=
# รหัสผ่านสำหรับ login เข้า UI ในเครื่องพัฒนา ไม่ใช่รหัสฐานข้อมูล
FACTORY_DEV_AUTH_PASSWORD=
# กุญแจเซ็น session ต้องเป็นข้อมูลสุ่ม 32 bytes แบบ base64url จำนวน 43 ตัวอักษร และห้ามใช้ซ้ำกับรหัสผ่าน
FACTORY_DEV_AUTH_SESSION_SECRET=
# รหัสผู้ดูแลระบบแบบใช้ครั้งเดียวสำหรับขั้นตอน setup ที่อนุมัติแล้วเท่านั้น และห้าม commit ค่า
# FACTORY_SETUP_ADMIN_PASSWORD=