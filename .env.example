# Development only. Copy manually to .env.local, which remains ignored.
# Do not use NEXT_PUBLIC_ keys or next.config.ts env for database settings.
FACTORY_DB_ENABLED=false
FACTORY_DB_HOST=localhost
FACTORY_DB_PORT=5432
FACTORY_DB_NAME=ionflow_inventory_dev
FACTORY_DB_SCHEMA=inventory_sandbox
# Suggested dedicated role; NOT created by this implementation.
FACTORY_DB_USER=ionflow_factory_app
# Set locally after an administrator approves role setup. Never commit a password.
FACTORY_DB_PASSWORD=
FACTORY_DB_POOL_MAX=5
FACTORY_DB_CONNECT_TIMEOUT_MS=5000
FACTORY_DB_IDLE_TIMEOUT_MS=10000
FACTORY_DB_STATEMENT_TIMEOUT_MS=5000

# Settings-only local API; no production auth bypass. Separate write identity.
FACTORY_SETTINGS_ENABLED=false
FACTORY_SETTINGS_DB_USER=factory_settings_writer
FACTORY_SETTINGS_DB_PASSWORD=
FACTORY_SETTINGS_APP_ORIGIN=http://localhost:3002

# Production Orders only. Never reuse the Settings or read-only identity.
FACTORY_PRODUCTION_ENABLED=false
FACTORY_PRODUCTION_DB_USER=factory_production_writer
FACTORY_PRODUCTION_DB_PASSWORD=
FACTORY_PRODUCTION_APP_ORIGIN=http://localhost:3000

# PR + PO PostgreSQL runtime. Keep disabled until migration 0006 and least-privilege role are approved.
FACTORY_PURCHASING_ENABLED=false
FACTORY_PURCHASING_DB_USER=factory_purchasing_writer
FACTORY_PURCHASING_DB_PASSWORD=

# Local Authentication V1. Enable only after approved 0001+0005 setup and trusted scope bootstrap.
FACTORY_AUTH_ENABLED=false
FACTORY_AUTH_DB_USER=factory_auth_runtime
FACTORY_AUTH_DB_PASSWORD=
FACTORY_AUTH_APP_ORIGIN=http://localhost:3000
# Keep disabled until tenant/organization IDs and an active Settings Site ID are approved.
FACTORY_AUTH_LOCAL_SCOPE_ENABLED=false
# FACTORY_AUTH_LOCAL_SCOPE_REGISTRY={"provenance":"<approved protected config>","settingsSiteAuthority":"<approved namespace>","tenant":{"authority":"<approved namespace>","id":"<approved id>","active":true},"organization":{"authority":"<approved namespace>","id":"<approved id>","tenantAuthority":"<same approved tenant namespace>","tenantId":"<same approved tenant id>","active":true},"sites":[{"authority":"<same Settings namespace>","id":"<verified active Settings site id>","organizationAuthority":"<same approved organization namespace>","organizationId":"<same approved organization id>","active":true}]}

# Local UI login without PostgreSQL. Development + localhost only; never use NEXT_PUBLIC_ names.
# This grants access to protected UI pages only. Business API permissions remain denied.
FACTORY_DEV_AUTH_ENABLED=false
FACTORY_DEV_AUTH_EMAIL=
FACTORY_DEV_AUTH_PASSWORD=
# Exactly 32 random bytes encoded as base64url (43 characters). Never reuse the password.
FACTORY_DEV_AUTH_SESSION_SECRET=
# Optional one-time local administrator secret for approved setup; never commit a value.
# FACTORY_SETUP_ADMIN_PASSWORD=1234
